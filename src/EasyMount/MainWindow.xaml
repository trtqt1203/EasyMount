<Window x:Class="EasyMount.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="EasyMount" Width="1200" Height="790" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#151E28" BorderBrush="#293442" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,28,18,22">
        <StackPanel DockPanel.Dock="Top">
          <Image Source="Assets/easymount.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,15"/>
          <TextBlock Text="EasyMount" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="YOUR CLOUD. YOUR DRIVE." FontSize="9" Foreground="{StaticResource Muted}" Margin="0,6,0,32"/>
          <Border Background="#203C35" CornerRadius="7" Padding="13,11"><TextBlock Text="▣   Ổ đĩa của tôi" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
          <Button Content="＋   Tài khoản cloud" Click="AccountsClick" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,7,0,0" Padding="13,11"/>
          <Button Content="?    Hướng dẫn" Click="HelpClick" HorizontalContentAlignment="Left" Background="Transparent" Padding="13,11"/>
          <Button Content="↗   Nhật ký" Click="LogsClick" HorizontalContentAlignment="Left" Background="Transparent" Padding="13,11"/>
          <Button Content="ⓘ   Giới thiệu" Click="AboutClick" HorizontalContentAlignment="Left" Background="Transparent" Padding="13,11"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Background="#1E2935" CornerRadius="9" Padding="13" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="Gọn trên máy." FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Truy cập file từ Explorer, tải nội dung khi cần." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
          </Border>
          <Button Content="Thoát ứng dụng" Click="QuitClick" Background="Transparent" HorizontalContentAlignment="Left" Padding="0,7" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="v0.3.4  ·  Windows x64" FontSize="10" Foreground="#718194" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,28,34,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="＋  Thêm ổ đĩa" Click="AddClick" Style="{StaticResource Primary}" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="Không gian làm việc" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Ổ đĩa của tôi" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Gộp nhiều cloud vào một ổ, ghi theo thứ tự ưu tiên." Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel>
      </DockPanel>
      <Border Grid.Row="1" x:Name="DriverBanner" Background="#332C1D" BorderBrush="#5E4C29" BorderThickness="1" CornerRadius="9" Padding="15,12" Margin="0,23,0,0">
        <DockPanel><Button DockPanel.Dock="Right" Content="Tải WinFsp ↗" Click="WinFspClick" Background="#514326" Foreground="#F1D495" Padding="12,8" Margin="16,0,0,0"/>
          <StackPanel><TextBlock Text="Cần WinFsp để gắn ổ đĩa" Foreground="#F1D495" FontWeight="SemiBold"/><TextBlock Text="Cài WinFsp một lần, sau đó mở lại EasyMount. Bạn vẫn có thể cấu hình tài khoản ngay." Foreground="#C5B58F" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="2" Margin="0,22,0,19">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SummaryText" Text="0 ổ đĩa  /  0 đang kết nối" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
        <Button Grid.Column="1" Content="Tài khoản cloud" Click="AccountsClick" Padding="12,8" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="↻  Làm mới" Click="RefreshClick" Padding="12,8"/>
      </Grid>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="EmptyPanel" Margin="22,16,22,0" VerticalAlignment="Top">
            <Border Background="#171F29" CornerRadius="15" Padding="36,32">
              <StackPanel>
                <Image Source="Assets/easymount.png" Width="68" Height="68" HorizontalAlignment="Left" Margin="0,0,0,23"/>
                <TextBlock Text="Cloud của bạn, thêm một lối vào." FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Gắn thư mục từ cloud thành ổ đĩa R:, S:… và dùng các ứng dụng quen thuộc để mở file." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,25"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button Content="＋  Google Drive" Click="GoogleClick" HorizontalContentAlignment="Left" Padding="17,15" Margin="0,0,10,0"/>
                  <Button Grid.Column="1" Content="＋  OneDrive" Click="OneDriveClick" HorizontalContentAlignment="Left" Padding="17,15"/>
                </Grid>
                <TextBlock Text="01  Liên kết tài khoản     →     02  Chọn ổ đĩa     →     03  Kết nối" Foreground="#718497" FontSize="11" Margin="0,23,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Mặc định chỉ đọc. Bật quyền ghi khi bạn muốn chỉnh sửa file trên cloud." FontSize="12" Foreground="{StaticResource Muted}" Margin="4,19,4,0"/>
          </StackPanel>
          <ItemsControl x:Name="DriveItems" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="#171F29" BorderBrush="#2B3847" BorderThickness="1" CornerRadius="11" Padding="19" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="#243E39" CornerRadius="10" Width="50" Height="55" VerticalAlignment="Top"><TextBlock Text="{Binding Letter}" Foreground="#7CE7BE" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Remote}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,9" TextTrimming="CharacterEllipsis" MaxHeight="35"/>
                    <WrapPanel><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,0,14,0"/><TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource Muted}" FontSize="12"/></WrapPanel>
                    <TextBlock Text="{Binding Error}" Foreground="#F3AC9F" FontSize="12" Margin="0,8,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="130">
                    <Button Content="{Binding ToggleLabel}" Click="ToggleClick" Tag="{Binding}" Style="{StaticResource Primary}" Padding="11,9"/>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,7,0,0">
                      <Button Content="Mở" Click="OpenClick" Tag="{Binding}" Background="Transparent" Padding="6,5" FontSize="11"/>
                      <Button Content="Sửa" Click="EditClick" Tag="{Binding}" Background="Transparent" Padding="6,5" FontSize="11"/>
                      <Button Content="Xóa" Click="RemoveClick" Tag="{Binding}" Background="Transparent" Padding="6,5" FontSize="11" Foreground="#C69895"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="4" BorderBrush="#293442" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,18,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="Sẵn sàng" FontSize="11" Foreground="{StaticResource Muted}" MaxHeight="36"/>
          <TextBlock Grid.Column="1" x:Name="EngineText" Text="rclone" Foreground="#718497" FontSize="11" Margin="14,0,0,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
